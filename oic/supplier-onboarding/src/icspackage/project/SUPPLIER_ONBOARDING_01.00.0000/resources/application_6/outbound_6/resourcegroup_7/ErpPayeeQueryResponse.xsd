<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://xmlns.example.com/oic/erp/suppliers" elementFormDefault="qualified">
   <xsd:element name="PayeeQueryResponse">
      <xsd:complexType><xsd:sequence>
         <xsd:element name="items" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType><xsd:sequence>
               <xsd:element name="PayeeId" type="xsd:string"/>
               <xsd:element name="PayeePartyIdentifier" type="xsd:string"/>
               <xsd:element name="SupplierSiteCode" type="xsd:string" minOccurs="0"/>
            </xsd:sequence></xsd:complexType>
         </xsd:element>
         <xsd:element name="count" type="xsd:int"/>
      </xsd:sequence></xsd:complexType>
   </xsd:element>
</xsd:schema>
